{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --filter=web",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\""
	},
	"devDependencies": {
		"eslint": "^8.57.0",
		"prettier": "^3.2.5",
		"turbo": "^2.5.6"
	},
	"name": "starter-rp-react-vite-ts-turborepo",
	"packageManager": "npm@11.11.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
